# -----------------------------------------------------------------------------
# SoftForge — Environment Configuration Template
# Copie este arquivo para .env: cp .env.example .env
# -----------------------------------------------------------------------------

# Ambiente de Execução (development | staging | production)
ENVIRONMENT=development
DEBUG=true

# API & Servidor Backend
API_PORT=8000
API_HOST=0.0.0.0
PROJECT_NAME="SoftForge API"
API_V1_STR=/api/v1

# Segurança & Autenticação (JWT)
# Gere uma chave segura com: openssl rand -hex 32
SECRET_KEY=change-this-ultra-secure-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Banco de Dados PostgreSQL (Docker Compose)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=softforge
POSTGRES_PASSWORD=softforge_secret
POSTGRES_DB=softforge_db

# URL de Conexão Async (usada pelo backend FastAPI / SQLAlchemy)
# Para conexão direta dentro do Docker use: postgresql+asyncpg://softforge:softforge_secret@db:5432/softforge_db
DATABASE_URL=postgresql+asyncpg://softforge:softforge_secret@localhost:5432/softforge_db

# CORS & Frontend Origins (separadas por vírgula)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Observabilidade & Logs
LOG_LEVEL=DEBUG
LOG_FORMAT=colored # 'colored' para desenvolvimento local, 'json' para produção

# Frontend
VITE_API_BASE_URL=http://localhost:8000
