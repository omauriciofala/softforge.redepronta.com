{
  "$schema": "../theme-schema.json",
  "name": "SoftForge Bootstrap Starter",
  "slug": "bootstrap-starter",
  "version": "1.0.0",
  "engine": "html-bootstrap",
  "author": "SoftForge Core Team",
  "description": "Tema visual clássico e ultra-compatível construído sobre Bootstrap 5.3 e Vanilla JS, consumindo contratos abertos da API SoftForge.",
  "tokens": {
    "colors": {
      "primary": "#4f46e5",
      "primary_foreground": "#ffffff",
      "background": "#f8fafc",
      "foreground": "#0f172a",
      "card": "#ffffff",
      "card_foreground": "#0f172a",
      "border": "#dee2e6",
      "muted": "#e2e8f0",
      "muted_foreground": "#6c757d",
      "accent": "#6366f1"
    },
    "typography": {
      "font_family": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "font_size_base": "16px",
      "line_height": "1.5"
    },
    "geometry": {
      "border_radius": "0.375rem"
    }
  },
  "assets": {
    "stylesheets": [
      "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    ],
    "scripts": [
      "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js",
      "./app.js"
    ]
  }
}
